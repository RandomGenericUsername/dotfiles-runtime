/*
 * skins/templates/ags-wallpaper-selector.gtk.css.j2 — selector dialog paint.
 *
 * Extracted from ../ags-wallpaper-selector/style.css. The dialog panel takes
 * surface.panel.bg/surface.panel.border-width/border/radius/shadow/blur. Cards, the crumb and the
 * hover bar take surface.card.bg/surface.card.radius + surface.*.border-width; fields and back/quick
 * controls take surface.control.radius; the LIVE badge and Apply pill take surface.pill.radius.
 * Ink, ink-dim, accent and type.size-title/type.size-body are skin knobs. Thumbnail radii,
 * margins, dock sizes and small type stay source literals.
 *
 * The selected-card ring is the source selection literal (@primary plus a
 * primary-container tint), not a skin token.
 */
window#wallpaper-selector-window {
  background-color: {{SKIN_SURFACE_CONTROL_BG}};
  color: {{SKIN_INK_INK}};
  font-family: {{SKIN_TYPE_FONT_FAMILY}};
}

.ws-root {
  min-width: 920px;
  min-height: 600px;
}

.ws-panel {
  background-color: {{SKIN_SURFACE_PANEL_BG}};
  border: {{SKIN_SURFACE_PANEL_BORDER_WIDTH}} solid {{SKIN_SURFACE_PANEL_BORDER}};
  border-radius: {{SKIN_SURFACE_PANEL_RADIUS}};
  padding: 14px 16px 12px;
  box-shadow: {{SKIN_SURFACE_PANEL_SHADOW}};
  backdrop-filter: {{SKIN_SURFACE_PANEL_BLUR}};
}

.ws-search {
  background-color: @surface_container;
  color: {{SKIN_INK_INK}};
  border: none;
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 8px;
  min-height: 26px;
}

.ws-search placeholder {
  color: alpha({{SKIN_INK_INK}}, 0.55);
}

.ws-ui-icon {
  opacity: 0.9;
}

.ws-crumb {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: {{SKIN_SURFACE_CARD_PADDING}} 14px;
}

.ws-crumb-thumb {
  border-radius: 8px;
}

.ws-crumb-name {
  font-size: {{SKIN_TYPE_SIZE_TITLE}};
  font-weight: 700;
}

.ws-crumb-sub {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK_DIM}};
}

.ws-back {
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid alpha({{SKIN_INK_INK}}, 0.25);
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 14px;
}

.ws-back:hover {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.ws-title {
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: {{SKIN_INK_INK_DIM}};
}

.ws-scroll {
  border-radius: 8px;
}

.ws-card {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: 0;
}

.ws-card:hover {
  border-color: {{SKIN_STATE_HOVER_RING}};
}

.ws-card.selected {
  border: 2px solid @primary;
  background-color: alpha(@primary_container, 0.12);
}

.ws-thumb {
  border-radius: 11px 11px 0 0;
}

.ws-thumb-loading {
  background-color: alpha({{SKIN_INK_INK}}, 0.07);
}

.ws-card-name {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  margin: 6px 10px 0;
}

.ws-card-sub {
  font-size: {{SKIN_TYPE_SIZE_META}};
  color: {{SKIN_INK_INK_DIM}};
  margin: 0 10px 8px;
}

.ws-live {
  font-size: 10px;
  font-weight: 700;
  background-color: {{SKIN_INK_ACCENT}};
  color: @on_primary;
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  padding: {{SKIN_SURFACE_PILL_PADDING}} 7px;
  margin: 6px 6px 0 0;
}

.ws-hoverbar {
  background-color: {{SKIN_SURFACE_CARD_BG}};
  border: {{SKIN_SURFACE_CARD_BORDER_WIDTH}} solid {{SKIN_SURFACE_CARD_BORDER}};
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: {{SKIN_SURFACE_CARD_PADDING}};
  margin: 0 6px 6px 0;
  min-height: 0;
}

.ws-busy .ws-variant-apply,
.ws-busy .ws-quick {
  opacity: 0.38;
}

.ws-quick {
  background-color: @primary_container;
  color: @on_primary_container;
  font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
  border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 14px;
  margin: 0;
  min-height: 0;
  font-size: {{SKIN_TYPE_SIZE_BODY}};
}

.ws-quick:hover {
  background-color: @primary;
  color: @on_primary;
}

.ws-variant {
  background: transparent;
  border: none;
  padding: 0;
}

.ws-variant .ws-thumb {
  border-radius: 8px;
}

.ws-variant-name {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: alpha({{SKIN_INK_INK}}, 0.85);
  margin-top: 6px;
}

.ws-variant-apply {
  font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
  background-color: alpha({{SKIN_INK_INK}}, 0.14);
  color: {{SKIN_INK_INK}};
  border-radius: {{SKIN_SURFACE_PILL_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}} 14px;
  margin-top: 4px;
}

.ws-variant-apply:hover {
  background-color: @primary;
  color: @on_primary;
}

.ws-empty {
  color: {{SKIN_INK_INK_DIM}};
  border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} dashed alpha({{SKIN_INK_INK}}, 0.25);
  border-radius: {{SKIN_SURFACE_CARD_RADIUS}};
  padding: {{SKIN_SURFACE_CONTROL_PADDING}};
}

.ws-status {
  font-size: {{SKIN_TYPE_SIZE_BODY}};
  color: {{SKIN_INK_INK_DIM}};
}
