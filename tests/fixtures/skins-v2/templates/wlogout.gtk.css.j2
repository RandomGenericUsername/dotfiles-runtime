/* wlogout — generated appearance (paint/rhythm only; structure stays static) */
window {
    background-color: {{SKIN_SURFACE_PANEL_BG}};
}

button {
    color: {{SKIN_INK_INK}};
    background-color: {{SKIN_SURFACE_CONTROL_BG}};
    border: {{SKIN_SURFACE_CONTROL_BORDER_WIDTH}} solid {{SKIN_SURFACE_CONTROL_BORDER}};
    border-radius: {{SKIN_SURFACE_CONTROL_RADIUS}};
    padding: {{SKIN_SURFACE_CONTROL_PADDING}};
    font-size: {{SKIN_SURFACE_CONTROL_FONT_SIZE}};
    font-weight: {{SKIN_SURFACE_CONTROL_FONT_WEIGHT}};
}

button:hover {
    color: {{SKIN_STATE_HOVER_INK}};
    background-color: {{SKIN_STATE_HOVER_FILL}};
    border-color: {{SKIN_STATE_HOVER_RING}};
}

button:focus {
    color: {{SKIN_STATE_FOCUS_INK}};
    background-color: {{SKIN_STATE_FOCUS_FILL}};
    border-color: {{SKIN_STATE_FOCUS_RING}};
}

button:active {
    color: {{SKIN_STATE_SELECTED_INK}};
    background-color: {{SKIN_STATE_SELECTED_FILL}};
    border-color: {{SKIN_STATE_SELECTED_RING}};
}

button span {
    font-family: {{SKIN_TYPE_FONT_FAMILY}};
    font-size: {{SKIN_TYPE_SIZE_TITLE}};
    font-weight: {{SKIN_TYPE_FONT_WEIGHT}};
    letter-spacing: {{SKIN_TYPE_LETTER_SPACING}};
}
