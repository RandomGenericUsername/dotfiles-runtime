{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dotfiles.local/schemas/current.schema.json",
  "title": "current.json (schema_version 2)",
  "description": "Single machine-checkable definition (AD-44). shared-data-contract.md prose is descriptive.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wallpaper", "monitors", "applied_at"],
  "properties": {
    "schema_version": { "const": 2 },
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "source_path", "applied_at"],
      "properties": {
        "hash": { "type": "string" },
        "source_path": { "type": "string" },
        "applied_at": { "type": "string" }
      }
    },
    "monitors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "source_hash", "fit_mode"],
        "properties": {
          "backend": {
            "type": "string",
            "enum": ["hyprpaper", "swaybg", "swww", "mpvpaper"]
          },
          "source_hash": { "type": "string" },
          "fit_mode": {
            "type": "string",
            "enum": ["cover", "contain", "fill", "tile", "center", "stretch"]
          },
          "mpv_options": { "type": ["string", "null"] },
          "ipc_socket": { "type": ["string", "null"] }
        }
      }
    },
    "palette": { "$ref": "#/definitions/entry" },
    "effects": { "$ref": "#/definitions/entry" },
    "icons": { "$ref": "#/definitions/entry" },
    "applied_at": { "type": "string" }
  },
  "definitions": {
    "entry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["hash", "generated_at"],
      "properties": {
        "hash": { "type": "string" },
        "generated_at": { "type": "string" }
      }
    }
  }
}
